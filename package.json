{
  "name": "savdochef",
  "version": "0.1.0",
  "description": "SavdoChef - offline restaurant POS",
  "main": "dist-electron/main/index.js",
  "author": "Boburmirzo Ergashev",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "prisma generate && electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.js --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:icons": "node --experimental-strip-types --no-warnings scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.30",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.2",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "prettier": "3.8.1",
    "prisma": "6.19.3",
    "sharp": "0.35.5",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "maxWorkers": 2,
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@main/(.*)$": "<rootDir>/src/main/$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.node.json"
        }
      ]
    }
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "decimal.js": "10.6.0",
    "zod": "4.6.5"
  },
  "prisma": {
    "schema": "prisma/schema.sqlite.prisma"
  }
}
