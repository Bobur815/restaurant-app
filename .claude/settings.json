{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm test*)",
      "Bash(npm run build)",
      "Bash(npm run build:icons*)",
      "Bash(npm run db:generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prettier*)",
      "Bash(npx eslint*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx jest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(ls*)",
      "Bash(pwd)",
      "WebFetch(domain:www.electronjs.org)",
      "WebFetch(domain:www.prisma.io)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:www.electron.build)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(npm version*)",
      "Bash(npm run dist*)",
      "Bash(npm run release*)",
      "Bash(npm run import:legacy*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Edit(/prisma/**)",
      "Write(/prisma/**)",
      "Edit(/src/main/database/migrations/**)",
      "Write(/src/main/database/migrations/**)",
      "Edit(/package.json)",
      "Edit(/electron-builder.config.js)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Edit(/src/generated/**)",
      "Write(/src/generated/**)",
      "Edit(**/*.db)",
      "Write(**/*.db)",
      "Edit(/package-lock.json)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(Remove-Item*-Recurse*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.ts\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
