// ------------ Datasource & Generator ------------
datasource db {
  provider = "sqlite"
  url      = "file:./data/app.db"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------- Enums ----------------
enum ExpenseType {
  residual_writeoff
  waste
  breakage
}

enum OrderStatus {
  pending
  completed
  cancelled
}

enum PaymentMethod {
  cash
  card
  click
  debt
}

enum PaymentStatus {
  paid
  pending
  refunded
}

enum PermissionModel {
  menu
  order
  payment
  user
  report
  branch
}

enum ResidualAction {
  CARRY_TO_NEXT
  WRITE_OFF
}

enum ResidualStatus {
  pending
  applied
}

enum UserRole {
  ADMIN
  STAFF
}

// --------------- Core Tables ---------------

// Category (unique name)
model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  menus Menu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Counter (for sequences like order_number)
model Counter {
  id  String @id // e.g. "orders"
  seq Int    @default(0)
}

// Expense
model Expense {
  id        Int         @id @default(autoincrement())
  sessionId Int?        
  menuId    Int?        
  type      ExpenseType
  note      String?     @default("")
  quantity  Decimal     @default(0)
  unitCost  Decimal     @default(0)
  amount    Decimal     @default(0)

  session   Session?   @relation(fields: [sessionId], references: [id])
  menu      Menu?      @relation(fields: [menuId], references: [id])
  residuals Residual[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([menuId])
  @@index([type])
}

// Menu
model Menu {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  price        Decimal @default(0)
  imageUrl     String? 
  description  String?
  categoryId   Int
  portions     Boolean @default(false)
  soldByWeight Boolean @default(false)

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  residuals  Residual[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Expense     Expense[]
  SessionItem SessionItem[]

  @@index([categoryId])
}

// Order
model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String?       @unique 
  tableNumber   Int?          
  orderDate     DateTime      @default(now())
  totalAmount   Decimal?       @default(0)
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod
  updateDate    DateTime      @default(now()) 

  items    OrderItem[]
  payments Payment[]

  @@index([status])
  @@index([paymentMethod])
}

// OrderItem
model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     
  menuId       Int     
  soldByWeight Boolean @default(false)

  // quantity: for weight items can be decimal; for non-weight should be integer -> enforce in service
  quantity Decimal  @default(1)
  units    Int? // only when soldByWeight = true
  weightKg Decimal?  @default(0) // only when soldByWeight = true
  portions Decimal? @default(1) // 1.0, 0.7, 0.5 -> enforce allowed values in service

  unitPrice  Decimal  @default(0)
  totalPrice Decimal  @default(0)

  order Order @relation(fields: [orderId], references: [id])
  menu  Menu  @relation(fields: [menuId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([menuId])
}

// Payment
model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int          
  amount        Decimal       @default(0)
  paymentDate   DateTime      @default(now()) 
  paymentMethod PaymentMethod
  status        PaymentStatus @default(paid)

  order Order @relation(fields: [orderId], references: [id])

  // Only createdAt needed; mongo had no updatedAt
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([status])
}

// Permission
model Permission {
  id              Int             @id @default(autoincrement())
  userId          Int
  permissionModel PermissionModel
  read            Boolean         @default(false)
  write           Boolean         @default(false)
  update          Boolean         @default(false)
  delete          Boolean         @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([permissionModel])
}

// Receipt settings (singleton via unique slug)
model RecieptSettings {
  id             Int      @id @default(autoincrement())
  restaurantName String
  address        String
  phone          String
  extraPhones    String?  @default("")
  footerNote     String   @default("")

  locale   String @default("uz-UZ")
  currency String @default("UZS")

  // Print nested object flattened for SQLite; keep in one row
  print_widthPx         Int     @default(420)
  print_useStarsSep     Boolean @default(true)
  print_separatorChar   String  @default("*")
  print_separatorCount  Int     @default(38)
  print_showAddress     Boolean @default(true)
  print_showPhone       Boolean @default(true)
  print_showDateTime    Boolean @default(true)
  print_showOrderNumber Boolean @default(true)

  logoUrl String?
  slug    String  @unique @default("default")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Residual
model Residual {
  id               Int            @id @default(autoincrement())
  sessionId        Int            
  menuId           Int           
  quantity         Decimal        @default(0)
  action           ResidualAction
  status           ResidualStatus @default(pending)
  appliedToSession Int?           
  expenseId        Int?          
  note             String?

  session        Session  @relation("ResidualSession", fields: [sessionId], references: [id])
  menu           Menu     @relation(fields: [menuId], references: [id])
  appliedSession Session? @relation("ResidualAppliedSession", fields: [appliedToSession], references: [id])
  expense        Expense? @relation(fields: [expenseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prisma doesn't support partial unique (status='pending') — workaround:
  // enforce uniqueness by (sessionId, menuId, status)
  @@unique([sessionId, menuId, status])
  @@index([sessionId])
  @@index([menuId])
  @@index([status])
  @@index([action])
}

// Session + SessionItem (subdocument -> separate table)
model Session {
  id       Int       @id @default(autoincrement())
  status   String    @default("open") // or use enum if you prefer
  closedAt DateTime?

  items     SessionItem[]
  residuals Residual[]    @relation("ResidualSession")
  applied   Residual[]    @relation("ResidualAppliedSession")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Expense   Expense[]
}

model SessionItem {
  id              Int     @id @default(autoincrement())
  sessionId       Int
  menuId          Int
  initialQuantity Decimal @default(0) 
  soldQuantity    Decimal @default(0)

  session Session @relation(fields: [sessionId], references: [id])
  menu    Menu    @relation(fields: [menuId], references: [id])

  // remainingQuantity is computed in service, not stored

  @@unique([sessionId, menuId]) // one row per menu in a session
  @@index([sessionId])
  @@index([menuId])
}

// Setting (key/value arbitrary)
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  full_name String?
  password  String
  role      UserRole @default(STAFF)
  is_active Boolean  @default(true)

  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
