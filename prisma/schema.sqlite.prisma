// SavdoChef - local SQLite schema (Electron main process).
//
// The app never runs `prisma migrate`. Real databases are created and upgraded by
// src/main/database/migrations/*.ts on every start; `database.test.ts` fails if this file and
// those migrations disagree, and prints the SQL for the next migration. See that test before
// changing anything here. Rules: additive changes only; never rename or drop a column that a
// released build has used.
//
// Money and quantities are Decimal. In SQLite that is a DECIMAL-affinity column; Prisma returns
// Prisma.Decimal. Convert at the IPC boundary with shared/utils/decimal.ts, never with Number().

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
  // Required by Prisma 6 (moves to prisma.config.ts in Prisma 7). Only the CLI reads it: the app
  // passes the userData database path explicitly (src/main/database/open.ts).
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

// Templates for the permission checkboxes (feature F2); what a user may do is `permissions`.
enum UserRole {
  ADMIN
  CASHIER
  STAFF
}

enum OrderStatus {
  pending
  completed
  cancelled
}

// How the customer gets the food (feature F1-B). Takeaway and delivery orders have no table:
// they store tableNumber 0 (the column predates them and is NOT NULL; see migration 0007).
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum DeliveryStatus {
  PREPARING
  ON_THE_WAY
  DELIVERED
}

enum PaymentMethod {
  cash
  card
  click
  debt
  // orders.paymentMethod only: the check was paid with several methods (one payment row each).
  mixed
}

// A repayment of debt, or (admin) forgiving part of it (feature F1-C).
enum DebtEntryKind {
  PAYMENT
  WRITE_OFF
}

enum PaymentStatus {
  paid
  pending
  refunded
}

enum SessionStatus {
  open
  closed
}

enum ResidualAction {
  CARRY_TO_NEXT
  WRITE_OFF
}

enum ResidualStatus {
  pending
  applied
}

enum ExpenseType {
  residual_writeoff
  waste
  breakage
}

// ==================== USERS & SETTINGS ====================

model User {
  id            Int       @id @default(autoincrement())
  // Display name (required by the app; the old username was copied here by migration 0009).
  fullName      String?
  // 998XXXXXXXXX. Unique; required by the app (users from before phones fill it in on edit).
  phone         String?   @unique
  // Login is a 4-digit PIN only (feature F2). HMAC-SHA256 of the PIN with the per-install key
  // (settings `pin_key`): deterministic, so a PIN can be looked up and kept unique. Null = cannot
  // log in. The digits never reach the database.
  pinHash       String?   @unique
  // The bcrypt PIN of an older version: works once, then becomes `pinHash` (auth.ts).
  legacyPinCode String?
  role          UserRole  @default(STAFF)
  // JSON list of permissions (shared/permissions.ts); the role only gives the defaults.
  permissions   String    @default("[]")
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ordersCreated    Order[]         @relation("OrderCreatedBy")
  paymentsTaken    Payment[]       @relation("PaymentCreatedBy")
  sessionsOpened   Session[]       @relation("SessionOpenedBy")
  sessionsClosed   Session[]       @relation("SessionClosedBy")
  expensesCreated  Expense[]       @relation("ExpenseCreatedBy")
  repaymentsTaken  DebtRepayment[] @relation("RepaymentCreatedBy")
  repaymentsVoided DebtRepayment[] @relation("RepaymentVoidedBy")

  @@map("users")
}

// Key/value app settings. `value` is JSON text, parsed by settings/ (Phase 3).
// Known keys are listed in src/main/database/seed.ts.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// Receipt layout. Exactly one row, always written with id = RECEIPT_SETTINGS_ID (1); legacy
// used a `slug = "default"` singleton. No @default: Prisma turns `@id @default(1)` into
// AUTOINCREMENT on SQLite.
model ReceiptSettings {
  id                   Int      @id
  restaurantName       String
  address              String   @default("")
  phone                String   @default("")
  extraPhones          String   @default("")
  footerNote           String   @default("")
  locale               String   @default("uz")
  currency             String   @default("UZS")
  logoPath             String?
  // Printer: Windows printer name; null = system default. Phase 7.
  printerName          String?
  printWidthPx         Int      @default(420)
  printUseStarsSep     Boolean  @default(true)
  printSeparatorChar   String   @default("*")
  printSeparatorCount  Int      @default(38)
  printShowAddress     Boolean  @default(true)
  printShowPhone       Boolean  @default(true)
  printShowDateTime    Boolean  @default(true)
  printShowOrderNumber Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("receipt_settings")
}

// What one order type's receipt shows (feature F3): DINE_IN is "General", then TAKEAWAY and
// DELIVERY. The restaurant's name, address, phones, language and separator stay shared in
// receipt_settings. No row = the type prints like General; no General row = like the old
// receipt_settings switches and footer (printing/layouts.ts). Images are file names in the
// image store (userData/img), widths in % of the paper.
model ReceiptLayout {
  orderType        OrderType @id
  showAddress      Boolean   @default(true)
  showPhone        Boolean   @default(true)
  showDateTime     Boolean   @default(true)
  showOrderNumber  Boolean   @default(true)
  showCustomer     Boolean   @default(true)
  footerNote       String    @default("")
  topImage         String?
  topImageWidth    Int       @default(60)
  bottomImage      String?
  bottomImageWidth Int       @default(40)
  updatedAt        DateTime  @updatedAt

  @@map("receipt_layouts")
}

// Named sequences, incremented inside the caller's transaction ("orders" -> orderNumber).
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

// ==================== CUSTOMERS ====================

// Someone the restaurant delivers to or (F1-C) gives credit to. Found by phone, which is stored
// as 12 digits, 998XXXXXXXXX (shared/utils/phone.ts).
model Customer {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?
  address   String?
  landmark  String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  payments   Payment[]
  repayments DebtRepayment[]

  @@map("customers")
}

// Money a customer brought back against their debt, or an amount an admin forgave. Never deleted:
// a mistake is voided (kept, struck through, left out of every balance).
model DebtRepayment {
  id          Int            @id @default(autoincrement())
  customerId  Int
  amount      Decimal
  kind        DebtEntryKind  @default(PAYMENT)
  // cash | card | click for PAYMENT; null for WRITE_OFF.
  method      PaymentMethod?
  note        String?
  createdById Int?
  createdAt   DateTime       @default(now())
  voidedAt    DateTime?
  voidedById  Int?
  voidReason  String?

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("RepaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy  User?    @relation("RepaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([customerId, voidedAt])
  @@index([createdAt])
  @@map("debt_repayments")
}

// ==================== HALLS & TABLES ====================

// A room or area of the restaurant (main hall, terrace, VIP rooms). Hidden, never deleted, once
// it has tables, so old orders keep their place in history.
model Hall {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables DiningTable[]

  @@map("halls")
}

// A table. `number` is unique across the restaurant (decided 2026-10-19) and is what orders store
// in `tableNumber`, so orders need no foreign key and old orders stay valid when tables move
// between halls or are hidden.
model DiningTable {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  hallId    Int
  // Optional name shown under the number ("VIP xona", "Deraza oldi").
  label     String?
  seats     Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hall Hall @relation(fields: [hallId], references: [id], onDelete: Restrict)

  @@index([hallId])
  @@map("dining_tables")
}

// ==================== MENU ====================

model Category {
  id        Int      @id @default(autoincrement())
  nameUz    String   @unique
  nameRu    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id           Int      @id @default(autoincrement())
  nameUz       String   @unique
  nameRu       String?
  description  String?
  price        Decimal  @default(0)
  // Optional purchase/production cost per unit (per kg for weight dishes). Write-offs are costed
  // at this; when it is not set they fall back to the sale price (legacy behaviour).
  costPrice    Decimal?
  // File name inside userData/img, served by the images protocol (Phase 3). Never a full path.
  imageFile    String?
  categoryId   Int
  // Legacy `portions` flag: the dish may be sold as 1 / 0.7 / 0.5 portions.
  hasPortions  Boolean  @default(false)
  soldByWeight Boolean  @default(false)
  // Soft delete: dishes referenced by orders, sessions or expenses are never removed.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  sessionItems SessionItem[]
  residuals    Residual[]
  expenses     Expense[]

  @@index([categoryId])
  @@map("menu_items")
}

// ==================== SESSIONS (trading day) ====================

model Session {
  id         Int           @id @default(autoincrement())
  status     SessionStatus @default(open)
  // 1 while open, NULL once closed. UNIQUE, so the database itself allows only one open
  // session (SQLite treats NULLs as distinct). Prisma cannot express a partial unique index.
  // Maintained by triggers from `status` (migration 0002): code never writes it. Create
  // sessions as open; inserting a closed one while another is open would hit the guard.
  openGuard  Int?          @unique @default(1)
  openedAt   DateTime      @default(now())
  closedAt   DateTime?
  openedById Int?
  closedById Int?
  updatedAt  DateTime      @updatedAt

  openedBy         User?         @relation("SessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy         User?         @relation("SessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  items            SessionItem[]
  orders           Order[]
  residuals        Residual[]    @relation("ResidualSession")
  appliedResiduals Residual[]    @relation("ResidualAppliedSession")
  expenses         Expense[]

  @@index([status])
  @@map("sessions")
}

// remaining = initialQuantity - soldQuantity (computed, never stored).
model SessionItem {
  id              Int     @id @default(autoincrement())
  sessionId       Int
  menuItemId      Int
  initialQuantity Decimal @default(0)
  soldQuantity    Decimal @default(0)

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, menuItemId])
  @@index([menuItemId])
  @@map("session_items")
}

// Leftover stock at session close. One row per (session, dish, action): legacy keyed the
// upsert on action but the unique constraint on status, which collided when the next session
// flipped CARRY rows to `applied` (inventory.md, quirk 5).
model Residual {
  id                 Int            @id @default(autoincrement())
  sessionId          Int
  menuItemId         Int
  quantity           Decimal        @default(0)
  action             ResidualAction
  status             ResidualStatus @default(pending)
  appliedToSessionId Int?
  expenseId          Int?           @unique
  note               String         @default("")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  session          Session  @relation("ResidualSession", fields: [sessionId], references: [id], onDelete: Restrict)
  appliedToSession Session? @relation("ResidualAppliedSession", fields: [appliedToSessionId], references: [id], onDelete: Restrict)
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  expense          Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, menuItemId, action])
  @@index([status, action])
  @@index([menuItemId])
  @@index([appliedToSessionId])
  @@map("residuals")
}

model Expense {
  id          Int         @id @default(autoincrement())
  sessionId   Int?
  menuItemId  Int?
  type        ExpenseType
  note        String      @default("")
  quantity    Decimal     @default(0)
  unitCost    Decimal     @default(0)
  amount      Decimal     @default(0)
  createdById Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  menuItem  MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  residual  Residual?

  @@index([sessionId])
  @@index([menuItemId])
  @@index([type])
  @@index([createdAt])
  @@map("expenses")
}

// ==================== ORDERS & PAYMENTS ====================

model Order {
  id              Int             @id @default(autoincrement())
  // YYYY-NNNNN from Counter("orders"), assigned inside the create transaction.
  orderNumber     String          @unique
  tableNumber     Int
  // = tableNumber while pending, NULL otherwise. UNIQUE, so the database allows at most one
  // pending order per table even with several devices (Phase 8.5). Same trick as Session.openGuard.
  // Maintained by triggers from status/tableNumber (migration 0003): code never writes it.
  pendingTable    Int?            @unique
  status          OrderStatus     @default(pending)
  sessionId       Int
  totalAmount     Decimal         @default(0)
  // Final method, copied from the payment when the order completes.
  paymentMethod   PaymentMethod?
  // Optimistic concurrency: every write checks and bumps it (Phase 8.5).
  version         Int             @default(0)
  orderType       OrderType       @default(DINE_IN)
  // Takeaway/delivery customer. The fields below are copies taken when the order was saved, so
  // the receipt and history show what was true then, whatever the customer record says later.
  customerId      Int?
  customerName    String?
  customerPhone   String?
  deliveryAddress String?
  // Landmark or courier note ("mo'ljal").
  deliveryNote    String?
  // Part of totalAmount; 0 unless DELIVERY.
  deliveryFee     Decimal         @default(0)
  deliveryStatus  DeliveryStatus?
  courierName     String?
  createdById     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?

  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy User?       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  payments  Payment[]

  @@index([status])
  @@index([tableNumber, status])
  @@index([sessionId])
  @@index([createdAt])
  @@index([orderType, status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  menuItemId    Int
  soldByWeight  Boolean  @default(false)
  quantity      Decimal  @default(1)
  // Weight items: number of units and kilograms per unit.
  units         Int?
  weightKg      Decimal?
  // Portion factor (1, 0.7, 0.5) for hasPortions dishes; null otherwise.
  portion       Decimal?
  unitPrice     Decimal  @default(0)
  totalPrice    Decimal  @default(0)
  // The quantity this line took from the session stock, computed once when the line is
  // written. Updates and cancels give back exactly this, so stock cannot drift the way legacy
  // did when create/update/cancel each recomputed it differently (inventory.md, quirk 1).
  stockQuantity Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// Payments are financial records: an order with payments cannot be deleted (Restrict).
model Payment {
  id          Int           @id @default(autoincrement())
  orderId     Int
  amount      Decimal       @default(0)
  method      PaymentMethod
  status      PaymentStatus @default(paid)
  paidAt      DateTime      @default(now())
  // Debt rows (method debt): who owes it, when it is due, and when repayments covered it (oldest
  // debt first; status becomes paid). Null customer = imported legacy debt, not assigned yet.
  customerId  Int?
  dueDate     DateTime?
  settledAt   DateTime?
  createdById Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paidAt])
  @@index([method])
  @@index([status])
  @@index([customerId, settledAt])
  @@map("payments")
}
