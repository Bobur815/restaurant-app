{
  "name": "savdochef-waiter",
  "version": "1.0.0",
  "private": true,
  "description": "SavdoChef Ofitsiant: the waiter phone app for a SavdoChef till (feature F20).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src index.ts",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "prebuild": "expo prebuild --platform android --clean",
    "apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "decimal.js": "10.6.0",
    "expo": "58.0.23",
    "expo-application": "58.1.2",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-intent-launcher": "58.0.3",
    "expo-localization": "58.0.5",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "lucide-react-native": "1.70.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "eslint": "9.39.2",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "typescript": "6.0.3"
  },
  "overrides": {
    "babel-preset-expo": "$babel-preset-expo",
    "@react-navigation/elements": "$@react-navigation/elements"
  }
}
